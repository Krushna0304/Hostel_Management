        eb1_0.status,
        eb1_0.total_amount,
        eb1_0.updated_at,
        ep1_0.notes,
        ep1_0.paid_at,
        ep1_0.payment_mode,
        ep1_0.payment_reference,
        ep1_0.razorpay_order_id,
        ep1_0.razorpay_payment_id,
        ep1_0.status,
        ep1_0.tenant_id 
    from
        electricity_payments ep1_0 
    join
        electricity_bills eb1_0 
            on eb1_0.bill_id=ep1_0.bill_id 
    join
        electricity_accounts ea1_0 
            on ea1_0.account_id=eb1_0.account_id 
    join
        rooms r1_0 
            on r1_0.room_id=ea1_0.room_id 
    join
        hostels h1_0 
            on h1_0.hostel_id=r1_0.hostel_id 
    where
        ep1_0.tenant_id=? 
    order by
        eb1_0.bill_year desc,
        eb1_0.bill_month desc
